<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A071B">

    <!-- Center Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        android:background="#141127"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="24dp"
        android:padding="24dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/login_page_mainbackcolor">

            <!-- App Icon -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@drawable/login_page_main_icon"
                android:contentDescription="App Logo"
                android:backgroundTint="#8663E1"
                android:scaleType="centerInside"
                android:background="@drawable/icon"
                android:padding="16dp"/>

            <!-- Title -->
            <TextView
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign in to continue"
                android:textSize="14sp"
                android:textColor="#8663E1"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Email Field -->
            <TextView
                android:text="Email Address"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_bg"
                android:hint="Enter your email"
                android:paddingHorizontal="12dp"
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp"/>

            <!-- Password Field -->
            <TextView
                android:text="Password"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/passwordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Enter your password"
                    android:paddingStart="12dp"
                    android:paddingEnd="48dp"
                    android:background="@drawable/input_bg"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:inputType="textPassword"/>

                <ImageView
                    android:id="@+id/showHideIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/rounded_butt"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"/>
            </RelativeLayout>

            <!-- Forgot Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textSize="12sp"
                android:textColor="#8663E1"
                android:layout_gravity="end"
                android:layout_marginBottom="24dp"/>

            <!-- Sign In Button -->
            <Button
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Sign In"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8663E1"
                android:background="@drawable/rounded_button"/>

            <!-- Sign Up -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <TextView
                    android:text="Don't have an account?"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text=" Sign Up"
                    android:textColor="#8663E1"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
